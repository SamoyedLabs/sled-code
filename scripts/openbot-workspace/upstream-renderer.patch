@@ -0,0 +1,82 @@
+import type { EventRoutine } from "@openbot/contracts/ipc-events";
+import { waitFor } from "@solidjs/testing-library";
+import { createRoot, createSignal, flush } from "solid-js";
+import { expect, it, vi } from "vitest";
+import { createChatWebhookRoutines } from "./RoutineWebhookChatCard";
+import type { EventRoutinesApi } from "./routine-webhooks-api";
+import type { AgentRoutinesApi } from "./routines-port";
+
+it("loads and refreshes the remote chat routine without a desktop bridge, ignoring a released source", async () => {
+  const routine: EventRoutine = {
+    id: "routine-owned",
+    owner: { kind: "agent", id: "agent-owned" },
+    name: "Owned",
+    instruction: "Owned",
+    active: false,
+    timezone: "UTC",
+    trigger: { kind: "webhook", url: null, eventType: null, filters: [] },
+    createdAt: "2026-11-05T11:00:00Z",
+    updatedAt: "2026-11-05T11:00:00Z",
+    limitPolicy: "wait",
+    missedPolicy: "skip",
+  };
+  let reload: (() => void) | undefined;
+  const unsubscribe = vi.fn();
+  const unexpected = async (): Promise<never> => {
+    throw new Error("Unexpected mutation or legacy read");
+  };
+  const routines: AgentRoutinesApi = {
+    listRoutines: unexpected,
+    listRoutineRuns: unexpected,
+    createRoutine: unexpected,
+    updateRoutine: unexpected,
+    deleteRoutine: unexpected,
+    testRoutine: unexpected,
+    onEvent(listener) {
+      reload = () => listener({ type: "routines-changed", agentId: "agent-owned" });
+      return unsubscribe;
+    },
+  };
+  const api: EventRoutinesApi = {
+    saveRoutine: unexpected,
+    deleteRoutine: unexpected,
+    testRoutine: unexpected,
+    rotateSecret: unexpected,
+    listActivity: unexpected,
+    listRoutines: vi.fn(async () => [routine]),
+    getStatus: vi.fn(async () => ({ supported: true, connected: false })),
+  };
+  let dispose = () => {};
+  const state = createRoot((stop) => {
+    dispose = stop;
+    const [source, setSource] = createSignal<
+      { api: EventRoutinesApi; agentId: string; routines: AgentRoutinesApi } | undefined
+    >({ api, agentId: "agent-owned", routines });
+    return { ...createChatWebhookRoutines(source), setSource };
+  });
+  try {
+    flush();
+    await waitFor(() => expect(state.state.routines.map((item) => item.id)).toEqual(["routine-owned"]));
+    expect(reload).toBeTypeOf("function");
+    api.listRoutines = vi.fn(async () => []);
+    reload?.();
+    await waitFor(() => expect(state.state.routines).toEqual([]));
+    let resolve!: (items: EventRoutine[]) => void;
+    api.listRoutines = vi.fn(
+      () =>
+        new Promise<EventRoutine[]>((done) => {
+          resolve = done;
+        }),
+    );
+    reload?.();
+    state.setSource(undefined);
+    flush();
+    expect(unsubscribe).toHaveBeenCalledOnce();
+    resolve([routine]);
+    await Promise.resolve();
+    flush();
+    expect(state.state.routines).toEqual([]);
+  } finally {
+    dispose();
+  }
+});
