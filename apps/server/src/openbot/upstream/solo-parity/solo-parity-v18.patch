index 0000000..793ff4b
--- /dev/null
+++ b/src/main/team-api/privileged-host-bootstrap.ts
@@ -0,0 +1,16 @@
+import type { AgentService } from "../../backend/agent-service";
+import type { PrivilegedOwnership } from "../../backend/database/privileged-ownership";
+import type { PrivilegedCommitClient } from "./privileged-commit-client";
+import { createQueueAttachmentHost } from "./queue-attachments-host";
+import type { PrivilegedResponseHost } from "./privileged-response-host";
+export function createPrivilegedHosts(options: {
+  secret: string; environmentId: string; agents: AgentService; ownership: PrivilegedOwnership;
+  client: PrivilegedCommitClient; getHostId(): string | undefined;
+}) {
+  const {client} = options;
+  // Readiness arrives only after real engine initialization; never block startup on fd4.
+  void client.ready().then(() => client.activate(options.environmentId, options.getHostId() ?? "")).catch(() => client.close());
+  const privileged: PrivilegedResponseHost = {...options, get enabled() {return client.capabilitiesEnabled;}};
+  const queue = createQueueAttachmentHost({...options,enabled:false});
+  return {sledPrivilegedResponses:privileged,sledQueueAttachments:{...queue,get enabled(){return client.capabilitiesEnabled;}}};
+}
