+import { fstatSync } from "node:fs";
+import { Socket } from "node:net";
+import type { Duplex } from "node:stream";
+import type { QueueCommitEffect } from "./queue-commit-client.ts";
+
+type Target = {
+  agentId: string;
+  threadId: string;
+  turnId: string;
+  messageId: string;
+  blockId: string;
+  requestId: string | number;
+};
+type CommitFrame =
+  | { operation: "hello" }
+  | { operation: "activate"; environmentId: string; hostId: string }
+  | ({ operation: "acquire" | "finish"; permit?: string } & Identity)
+  | { operation: "queue-acquire" | "queue-finish"; principal: string; effect: QueueCommitEffect; permit?: string };
+type Identity = { principal: string; target: Target; nonce: string };
+const unavailable = () => new Error("Privileged commit unavailable");
+
+/** Owns only metadata on the inherited supervisor channel. Never retries a consumed attempt. */
+export class PrivilegedCommitClient {
+  readonly #pipe: Duplex;
+  readonly #pending = new Map<
+    string,
+    {
+      resolve(value: { permit?: string; deadline?: number; incarnation?: string; enabled?: boolean; environmentId?: string; hostId?: string }): void;
+      reject(error: Error): void;
+    }
+  >();
+  readonly #attempts = new Set<string>();
+  readonly #leases = new Map<string, number>();
+  readonly #active = new Set<symbol>();
+  readonly #drainWaiters = new Set<{
+    resolve(): void;
+    reject(error: Error): void;
+  }>();
+  #membershipChanges = 0;
+  #ownership:
+    | {
+        acquire(target: { agentId: string; threadId: string }, nonce: string, incarnation: string): { release(): void };
+      }
+    | undefined;
+  setOwnership(ownership: {
+    acquire(target: { agentId: string; threadId: string }, nonce: string, incarnation: string): { release(): void };
+  }): void {
+    if (this.#ownership) throw unavailable();
+    this.#ownership = ownership;
+  }
+  #sequence = 0;
+  #ready: Promise<string> | undefined;
+  #closed = false;
+  #activationAttempted = false;
+  #activated = false;
+  get capabilitiesEnabled(): boolean {
+    return this.#activated && !this.#closed && this.#ownership !== undefined && this.#membershipChanges === 0;
+  }
+  async activate(environmentId: string, hostId: string): Promise<void> {
+    if (this.#activationAttempted || !this.#ownership || !environmentId || !hostId) throw unavailable();
+    this.#activationAttempted = true;
+    const incarnation = await this.ready();
+    const reply = await this.#send({operation:"activate",environmentId,hostId});
+    if (reply.incarnation !== incarnation || reply.environmentId !== environmentId || reply.hostId !== hostId || typeof reply.enabled !== "boolean") { this.close(); throw unavailable(); }
+    this.#activated = reply.enabled;
+  }
+  constructor(pipe: Duplex) {
+    this.#pipe = pipe;
+    let buffer = "";
+    pipe.setEncoding("utf8");
+    pipe.on("error", () => this.close());
+    pipe.on("close", () => this.close());
+    pipe.on("end", () => this.close());
+    pipe.on("data", (chunk: string) => {
+      buffer += chunk;
+      if (Buffer.byteLength(buffer) > 8192) {
+        this.close();
+        return;
+      }
+      while (buffer.includes("\n")) {
+        const end = buffer.indexOf("\n");
+        const line = buffer.slice(0, end);
+        buffer = buffer.slice(end + 1);
+        try {
+          const reply = JSON.parse(line);
+          if (
+            !reply ||
+            typeof reply.id !== "string" ||
+            typeof reply.ok !== "boolean" ||
+            Object.keys(reply).some((k) => !["id", "ok", "permit", "deadline", "incarnation", "enabled", "environmentId", "hostId"].includes(k))
+          )
+            throw unavailable();
+          const pending = this.#pending.get(reply.id);
+          if (!pending) throw unavailable();
+          this.#pending.delete(reply.id);
+          if (!reply.ok) pending.reject(unavailable());
+          else pending.resolve(reply);
+        } catch {
+          this.close();
+          return;
+        }
+      }
+    });
+  }
+  static inherited(): PrivilegedCommitClient {
+    const fd = fstatSync(4);
+    if (!fd.isSocket() && !fd.isFIFO()) throw unavailable();
+    return new PrivilegedCommitClient(new Socket({ fd: 4, readable: true, writable: true }));
+  }
+  close(): void {
+    if (this.#closed) return;
+    this.#closed = true;
+    this.#pipe.destroy();
+    for (const pending of this.#pending.values()) pending.reject(unavailable());
+    this.#pending.clear();
+    for (const waiter of this.#drainWaiters) waiter.reject(unavailable());
+    this.#drainWaiters.clear();
+  }
+  #send(fields: CommitFrame) {
+    if (this.#closed || this.#pending.size >= 32) return Promise.reject(unavailable());
+    const id = String(++this.#sequence);
+    const frame = `${JSON.stringify({ id, ...fields })}\n`;
+    if (Buffer.byteLength(frame) > 8192) return Promise.reject(unavailable());
+    return new Promise<{
+      permit?: string;
+      deadline?: number;
+      incarnation?: string;
+      enabled?: boolean; environmentId?: string; hostId?: string;
+    }>((resolve, reject) => {
+      this.#pending.set(id, { resolve, reject });
+      this.#pipe.write(frame, (error) => {
+        if (error) this.close();
+      });
+    });
+  }
+  #request(operation: "acquire" | "finish", input: Identity, permit?: string) {
+    const target = input.target;
+    return this.#send({
+      operation,
+      principal: input.principal,
+      nonce: input.nonce,
+      target: {
+        agentId: target.agentId,
+        threadId: target.threadId,
+        turnId: target.turnId,
+        messageId: target.messageId,
+        blockId: target.blockId,
+        requestId: target.requestId,
+      },
+      ...(permit ? { permit } : {}),
+    });
+  }
+  async beginMembershipChange(): Promise<() => void> {
+    if (this.#closed) throw unavailable();
+    this.#membershipChanges++;
+    if (this.#active.size) await new Promise<void>((resolve, reject) => this.#drainWaiters.add({ resolve, reject }));
+    let finished = false;
+    return () => {
+      if (!finished) {
+        finished = true;
+        this.#membershipChanges--;
+      }
+    };
+  }
+  #beginAttempt(): symbol {
+    if (this.#closed || this.#membershipChanges) throw unavailable();
+    const attempt = Symbol();
+    this.#active.add(attempt);
+    return attempt;
+  }
+  #finishAttempt(attempt: symbol): void {
+    this.#active.delete(attempt);
+    if (this.#active.size === 0) {
+      for (const waiter of this.#drainWaiters) waiter.resolve();
+      this.#drainWaiters.clear();
+    }
+  }
+  async acquireQueueCommit(principal: string, effect: QueueCommitEffect) {
+    const incarnation = await this.ready();
+    if (!this.#ownership) throw unavailable();
+    const attempt = JSON.stringify(["queue-attachments", effect.editId]);
+    if (this.#attempts.has(attempt)) throw unavailable();
+    this.#attempts.add(attempt);
+    const active = this.#beginAttempt();
+    let ownership: { release(): void };
+    try {
+      ownership = this.#ownership.acquire(effect, attempt, incarnation);
+    } catch (error) {
+      this.#finishAttempt(active);
+      throw error;
+    }
+    const identity = {
+      purpose: effect.purpose,
+      agentId: effect.agentId,
+      threadId: effect.threadId,
+      taskId: effect.taskId,
+      deliveryId: effect.deliveryId,
+      editId: effect.editId,
+      expectedRevision: effect.expectedRevision,
+      requestHash: effect.requestHash,
+    };
+    const reply = await this.#send({
+      operation: "queue-acquire",
+      principal,
+      effect: identity,
+    }).catch((error) => {
+      this.close();
+      throw error;
+    });
+    if (typeof reply.permit !== "string" || typeof reply.deadline !== "number" || !Number.isFinite(reply.deadline)) {
+      this.close();
+      throw unavailable();
+    }
+    const deadline = reply.deadline;
+    let released = false;
+    return {
+      assertCommit: () => {
+        if (this.#closed || this.#membershipChanges || released || Date.now() >= deadline) throw unavailable();
+      },
+      release: async () => {
+        if (released) throw unavailable();
+        released = true;
+        await this.#send({
+          operation: "queue-finish",
+          principal,
+          effect: identity,
+          permit: reply.permit,
+        });
+        ownership.release();
+        this.#finishAttempt(active);
+      },
+    };
+  }
+  ready(): Promise<string> {
+    if (this.#ready) return this.#ready;
+    this.#ready = this.#send({ operation: "hello" }).then((reply) => {
+      if (typeof reply.incarnation !== "string" || !reply.incarnation) {
+        this.close();
+        throw unavailable();
+      }
+      return reply.incarnation;
+    });
+    return this.#ready;
+  }
+  assertDeadline(nonce: string): void {
+    const deadline = this.#leases.get(nonce);
+    if (this.#closed || this.#membershipChanges || (deadline !== undefined && Date.now() >= deadline))
+      throw unavailable();
+  }
+  async acquireCommit(principal: string, target: Target, nonce: string) {
+    await this.ready();
+    if (this.#attempts.has(nonce)) throw unavailable();
+    this.#attempts.add(nonce);
+    const active = this.#beginAttempt();
+    const input = { principal, target: { ...target }, nonce };
+    const reply = await this.#request("acquire", input).catch((error) => {
+      this.close();
+      throw error;
+    });
+    if (typeof reply.permit !== "string" || typeof reply.deadline !== "number" || !Number.isFinite(reply.deadline)) {
+      this.close();
+      throw unavailable();
+    }
+    this.#leases.set(nonce, reply.deadline);
+    let released = false;
+    return {
+      release: async () => {
+        if (released) throw unavailable();
+        released = true;
+        await this.#request("finish", input, reply.permit);
+        this.#leases.delete(nonce);
+        this.#finishAttempt(active);
+      },
+    };
+  }
+}
diff --git a/src/main/team-api/privileged-host-bootstrap.ts b/src/main/team-api/privileged-host-bootstrap.ts
