+import { isDynamicRecord } from "../runtime-values";
+import { adminRoute, boolean, count, empty, fields, identifier, nullable, oneOf, string, type OptionalRouteCodec, type AdminDecoder } from "./admin-wire";
+import { channelRequest, CHANNEL_ROUTES } from "./channels-v1";
+export const SLED_CHANNEL_CODING_CAPABILITY = "sled-channel-coding-assignment-v1";
+export const SLED_CHANNEL_CODING_ROUTES = {
+ progress: "/v1/sled/channel-coding/progress",
+ status: "/v1/sled/channel-coding/status", configure: "/v1/sled/channel-coding/configure",
+ send: "/v1/sled/channel-coding/send", recover: "/v1/sled/channel-coding/recover",
+ renew: "/v1/sled/channel-coding/renew",
+ verify: "/v1/sled/channel-coding/verify", receipt: "/v1/sled/channel-coding/receipt", submit: "/v1/sled/channel-coding/submit",
+} as const;
+const hash: AdminDecoder = value => { if (typeof value !== "string" || !/^[a-f0-9]{64}$/.test(value)) throw new Error("Invalid channel credential."); return value; };
+const command: AdminDecoder = value => { if (!isDynamicRecord(value) || value.type !== "send") throw new Error("Expected a channel send."); return channelRequest(CHANNEL_ROUTES.command, value); };
+const binding = fields({channelId:identifier,taskId:identifier,taskRevision:count,assignmentId:identifier,agentId:identifier,turnId:identifier,requestMessageId:identifier,requesterId:identifier,operationId:identifier});
+const leaseFields = fields({reservedAt:count,expiresAt:count,providerCompleted:boolean},{renewedAt:count});
+const lease: AdminDecoder = value => {
+ const decoded = leaseFields(value);
+ if (!isDynamicRecord(decoded) || typeof decoded.reservedAt !== "number" || typeof decoded.expiresAt !== "number") throw new Error("Invalid coding lease.");
+ const start = decoded.renewedAt ?? decoded.reservedAt;
+ if (typeof start !== "number" || start < decoded.reservedAt || decoded.expiresAt <= start || decoded.expiresAt - start > 30 * 60000) throw new Error("Invalid coding lease.");
+ return decoded;
+};
+const receipt = fields({binding, result:nullable(fields({messageId:string(1200),text:string(100000)}))}, {lease});
+const progress = fields({eventId:hash,status:oneOf("executing","needs_input","needs_approval"),updatedAt:string(64)});
+const attributed = fields({originRef:hash,operationId:identifier,payloadHash:hash,actorId:identifier,messageId:identifier,channelId:identifier,receiptId:string(512)});
+export const SLED_CHANNEL_CODING_CODECS: ReadonlyMap<string, OptionalRouteCodec> = new Map([
+ [SLED_CHANNEL_CODING_ROUTES.progress,adminRoute(fields({credential:hash,event:progress}),fields({eventId:hash,status:oneOf("executing","needs_input","needs_approval"),updatedAt:string(64),delivery:oneOf("accepted","rejected","uncertain")}))],
+ [SLED_CHANNEL_CODING_ROUTES.status,adminRoute(empty,fields({capability:oneOf(SLED_CHANNEL_CODING_CAPABILITY),available:boolean},{progressCapability:oneOf("sled-channel-coding-progress-v1")}))],
+ [SLED_CHANNEL_CODING_ROUTES.configure,adminRoute(fields({mcpServerId:string(512)}),fields({configured:boolean}))],
+ [SLED_CHANNEL_CODING_ROUTES.send,adminRoute(fields({originRef:hash,command}),attributed)],
+ [SLED_CHANNEL_CODING_ROUTES.recover,adminRoute(fields({originRef:hash,channelId:identifier,operationId:identifier}),nullable(attributed))],
+ [SLED_CHANNEL_CODING_ROUTES.verify,adminRoute(fields({credential:hash,purpose:oneOf("launch","reconcile")}),fields({originRef:nullable(hash),requesterKind:oneOf("session","routine","agent"),binding,expiresAt:count,payloadHash:hash}))],
+ [SLED_CHANNEL_CODING_ROUTES.renew,adminRoute(fields({credential:hash}),receipt)],
+ [SLED_CHANNEL_CODING_ROUTES.receipt,adminRoute(fields({credential:hash}),nullable(receipt))],
+ [SLED_CHANNEL_CODING_ROUTES.submit,adminRoute(fields({credential:hash,text:string(100000)}),receipt)],
+]);
