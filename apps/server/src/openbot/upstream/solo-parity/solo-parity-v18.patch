new file mode 100644
index 0000000..3156bc5
--- /dev/null
+++ b/.sled-workspace/browser.ts
@@ -0,0 +1,114 @@
+import type { BrowserLiveViewEvent } from "@openbot/contracts/ipc";
+import {
+  browserViewInputForHost,
+  decodeBrowserViewFrame,
+  decodeBrowserViewHostMessage,
+  decodeBrowserViewInputValue,
+} from "@openbot/contracts/team-protocol/browser-view-v1";
+import { isDynamicRecord } from "@openbot/contracts/runtime-values";
+import type { WebWorkspaceRuntime } from "../src/renderer/src/features/web-client/web-runtime";
+
+export function createSledBrowser(
+  call: (method: string, args: unknown) => Promise<unknown>,
+  host: () => string | null,
+) {
+  const listeners = new Set<(event: BrowserLiveViewEvent) => void>();
+  let view: {
+    id: string;
+    tabId: string;
+    hostId: string;
+    framePoint: boolean;
+    clipboard: boolean;
+  } | null = null;
+  const emit = (event: BrowserLiveViewEvent) => {
+    for (const listener of listeners) listener(event);
+  };
+  const stop = async () => {
+    const current = view;
+    view = null;
+    if (current) await call("browser-close", { id: current.id, hostId: current.hostId });
+  };
+  const browser: WebWorkspaceRuntime["browser"] = {
+    async startLiveView(tabId) {
+      await stop();
+      const hostId = host();
+      if (!hostId) throw new Error("Select a connected Sled environment");
+      const current = {
+        id: crypto.randomUUID(),
+        tabId,
+        hostId,
+        framePoint: false,
+        clipboard: false,
+      };
+      view = current;
+      try {
+        const features = await call("browser-open", { id: current.id, hostId, tabId });
+        if (view !== current) {
+          await call("browser-close", { id: current.id, hostId });
+          throw new Error("The browser view changed while opening");
+        }
+        if (isDynamicRecord(features)) {
+          current.framePoint = features.framePoint === true;
+          current.clipboard = features.clipboard === true;
+        }
+      } catch (error) {
+        if (view === current) view = null;
+        throw error;
+      }
+    },
+    stopLiveView: stop,
+    async sendLiveViewInput(input) {
+      const current = view;
+      if (!current) throw new Error("The browser view is not connected");
+      const wire = browserViewInputForHost(
+        decodeBrowserViewInputValue(input),
+        current.framePoint,
+        current.clipboard,
+      );
+      if (wire)
+        await call("browser-input", { id: current.id, hostId: current.hostId, input: wire });
+    },
+    onLiveViewEvent(listener) {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+  };
+  return {
+    browser,
+    activeTabId: () => view?.tabId ?? null,
+    stop,
+    receive(value: unknown) {
+      const current = view;
+      if (!current || !isDynamicRecord(value) || value.id !== current.id) return;
+      if (value.type === "closed") {
+        view = null;
+        emit({
+          type: "stopped",
+          tabId: current.tabId,
+          reason: "The browser view closed. Reopen to continue.",
+        });
+        return;
+      }
+      if (value.type !== "data") return;
+      try {
+        if (value.data instanceof ArrayBuffer) {
+          const frame = decodeBrowserViewFrame(new Uint8Array(value.data));
+          emit({ type: "frame", tabId: current.tabId, ...frame });
+        } else if (typeof value.data === "string") {
+          const message = decodeBrowserViewHostMessage(value.data);
+          if (message?.type === "copied" || message?.type === "copyTooLarge")
+            emit({ ...message, tabId: current.tabId });
+        }
+      } catch {
+        void stop().catch(() => undefined);
+        emit({
+          type: "stopped",
+          tabId: current.tabId,
+          reason: "The browser sent an invalid frame.",
+        });
+      }
+    },
+  };
+}
diff --git a/.sled-workspace/computer.tsx b/.sled-workspace/computer.tsx
new file mode 100644
index 0000000..a3259ed
--- /dev/null
+++ b/.sled-workspace/computer.tsx
@@ -0,0 +1,121 @@
+import type { RemoteDesktopSession, ServerSummary } from "@openbot/contracts/ipc";
+import { RemoteDesktopWorkspace } from "@openbot/ui/features/remote-desktop/RemoteDesktopWorkspace";
+import { createStore, Show } from "solid-js";
+import { z } from "zod";
+
+const opened = z.object({
+  id: z.string().uuid(),
+  url: z.string().url(),
+  capabilities: z.object({
+    platform: z.enum(["darwin", "win32", "linux"]),
+    selectedDisplayId: z.string().nullable(),
+    displays: z.array(
+      z.object({
+        id: z.string(),
+        label: z.string(),
+        width: z.number(),
+        height: z.number(),
+        primary: z.boolean(),
+      }),
+    ),
+  }),
+});
+
+export function createWorkspaceComputer(call: (method: string, args: unknown) => Promise<unknown>) {
+  const [state, setState] = createStore<{
+    server: ServerSummary | null;
+    session: RemoteDesktopSession | undefined;
+    platform: "darwin" | "win32" | "linux";
+    connecting: boolean;
+    error: string | null;
+  }>({ server: null, session: undefined, platform: "darwin", connecting: false, error: null });
+  let generation = 0;
+  let lease: { id: string; hostId: string } | null = null;
+  async function close() {
+    generation++;
+    const current = lease;
+    if (current) await call("computer-close", current);
+    if (lease === current) lease = null;
+    setState((state) => {
+      state.server = null;
+      state.session = undefined;
+      state.connecting = false;
+      state.error = null;
+    });
+  }
+  async function open(server: ServerSummary) {
+    await close();
+    const current = generation;
+    setState((state) => {
+      state.server = server;
+      state.connecting = true;
+      state.error = null;
+    });
+    try {
+      const result = opened.parse(await call("computer-open", { hostId: server.id }));
+      if (current !== generation) {
+        await call("computer-close", { id: result.id, hostId: server.id });
+        return;
+      }
+      lease = { id: result.id, hostId: server.id };
+      const url = new URL(result.url);
+      const viewerGrant = url.hash.slice(1);
+      url.hash = "";
+      setState((state) => {
+        state.platform = result.capabilities.platform;
+        state.connecting = false;
+        state.session = {
+          id: result.id,
+          serverId: server.id,
+          viewerUrl: url.href,
+          viewerGrant,
+          displays: result.capabilities.displays,
+          selectedDisplayId: result.capabilities.selectedDisplayId,
+          phase: "connecting",
+          transport: "unknown",
+          errorCode: null,
+          message: null,
+          createdAt: new Date().toISOString(),
+          grantExpiresAt: new Date(Date.now() + 30_000).toISOString(),
+        };
+      });
+    } catch (error) {
+      if (current === generation)
+        setState((state) => {
+          state.connecting = false;
+          state.error = error instanceof Error ? error.message : "Computer viewer unavailable";
+        });
+    }
+  }
+  function View() {
+    return (
+      <Show when={state.server}>
+        {(server) => (
+          <RemoteDesktopWorkspace
+            visible={true}
+            platform={state.platform}
+            server={server()}
+            session={state.session}
+            connecting={state.connecting}
+            connectionError={state.error}
+            connectionErrorCode={null}
+            onHide={() => {
+              void close().catch((error) =>
+                setState((state) => {
+                  state.error = String(error);
+                }),
+              );
+            }}
+            onDisconnect={close}
+            onRetry={() => open(server())}
+            onSelectDisplay={async (hostId, displayId) => {
+              await call("computer-display", { hostId, displayId });
+              await open(server());
+            }}
+          />
+        )}
+      </Show>
+    );
+  }
+  return { open, close, View };
+}
