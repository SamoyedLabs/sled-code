+import { HttpError } from "../main/team-api/http-error";
+import type { TeamApiRequestContext } from "../main/team-api/request-context";
+function requiredCodec(path: string) {
+  const codec = teamSideRouteCodec(path);
+  if (!codec) throw new Error("Queue route codec missing");
+  return codec;
+}
+const scope = {
+  environmentId: "environment",
+  hostId: "host",
+  agentId: "agent",
+  threadId: "thread",
+  taskId: null,
+  deliveryId: "delivery",
+  editId: "edit",
+};
+const revision = "a".repeat(64);
+const receipt = {
+  requestHash: "b".repeat(64),
+  deliveryId: "delivery",
+  editId: "edit",
+  expectedRevision: revision,
+  messageId: "message",
+  attachments: [],
+};
+const edit = {
+  ...scope,
+  expectedRevision: revision,
+  text: "edited",
+  keepAttachmentIds: [],
+  uploads: [
+    {
+      draftId: "draft",
+      identity: {
+        operationId: "upload",
+        hostId: "host",
+        agentId: "agent",
+        threadId: "thread",
+        taskId: null,
+        name: "proof.txt",
+        mimeType: "text/plain",
+        size: 3,
+        sha256: "c".repeat(64),
+      },
+    },
+  ],
+};
+for (const action of ["context", "save", "result"]) {
+  it(`returns actual ${action} route refusal through the negotiated response encoder`, async () => {
+    const path = `/v1/sled/queue-attachments/${action}`;
+
+    const bytes = Buffer.from(JSON.stringify(action === "context" ? scope : edit));
+    const socket = new Socket();
+    const request = new IncomingMessage(socket);
+    const response = new ServerResponse(request);
+    request.headers = {
+      "content-length": String(bytes.length),
+      "x-sled-queue-attachments": signQueueAttachmentsBinding(
+        "secret",
+        {
+          principal: "principal",
+          hostId: "host",
+          method: "POST",
+          path,
+          bodySha256: createHash("sha256").update(bytes).digest("hex"),
+        },
+        Date.now(),
+      ),
+    };
+    request.push(bytes);
+    request.push(null);
+    let output: { status: number; body: string } | undefined;
+    const context: TeamApiRequestContext = {
+      request,
+      response,
+      method: "POST",
+      url: new URL(path, "http://fixture.invalid"),
+      protocol: 9,
+      capabilities: new Set(["sled-queue-attachments-v1"]),
+      member: {
+        id: "member",
+        username: "member",
+        email: null,
+        name: null,
+        role: "owner",
+        createdAt: "2026-11-04",
+        disabled: false,
+      },
+      token: "fixture",
+      sessionId: "fixture",
+      sessionExpiresAt: "2099-01-01",
+      agentLevel: () => "manage",
+      json: (status, value) => {
+        output = { status, body: JSON.stringify(requiredCodec(path).response(path, status, value, {})) };
+        return "handled";
+      },
+      empty: () => "handled",
+    };
+    const agents = {
+      queueAttachmentContext: () => ({ expectedRevision: revision, text: "original", keepAttachmentIds: [] }),
+      queueAttachmentResult: () => receipt,
+      saveQueueAttachments: () => Effect.succeed(receipt),
+    };
+    try {
+      const denied = new HttpError(403, "Original queue authority refused");
+      const trusted = {
+        secret: "secret",
+        hostId: "host",
+        environmentId: "environment",
+        validate: () => {
+          throw denied;
+        },
+        acquireCommit: async () => ({ assertCommit() {}, release: async () => {} }),
+      };
+      await expect(routeSledQueueAttachments(context, agents, trusted)).rejects.toBe(denied);
+      // Same error response path used by TeamApiServer's HttpError handler.
+      expect(context.json(denied.status, { error: denied.message })).toBe("handled");
+      expect(output?.status).toBe(403);
+      expect(JSON.parse(output?.body ?? "null")).toEqual({ error: denied.message });
+      for (const status of [400, 401, 403, 404, 409, 413, 500, 503]) {
+        const body = { error: "Exact refusal", code: "queue-conflict", secret: "must not leak" };
+        const encoded = JSON.stringify(requiredCodec(path).response(path, status, body, {}));
+        expect(requiredCodec(path).response(path, status, JSON.parse(encoded))).toEqual({
+          error: "Exact refusal",
+          code: "queue-conflict",
+        });
+      }
+    } finally {
+      request.destroy();
+      socket.destroy();
+    }
+  });
+}
+it("preserves authoritative context, exact accepted receipts and missing results; rejects malformed success", () => {
+  const base = "/v1/sled/queue-attachments/";
+  for (const [action, value] of [
+    ["context", { expectedRevision: revision, text: "original", keepAttachmentIds: ["kept"] }],
+    ["save", receipt],
+    ["result", receipt],
+    ["result", null],
+  ] as const) {
+    const encoded = JSON.stringify(requiredCodec(base + action).response(base + action, 200, value, {}));
+    expect(requiredCodec(base + action).response(base + action, 200, JSON.parse(encoded))).toEqual(value);
+  }
+  for (const action of ["context", "save", "result"])
+    expect(() => requiredCodec(base + action).response(base + action, 200, { error: "not a success" }, {})).toThrow();
+});
