@@ -0,0 +1,52 @@
+import { isDynamicRecord } from "@openbot/contracts/runtime-values";
+import { LOCAL_CATALOG_CAPABILITY, LOCAL_CATALOG_ROUTES, LOCAL_CATALOG_CODECS, LOCAL_CATALOG_BUNDLE_PATH } from "@openbot/contracts/team-protocol/local-skill-catalog-v1";
+import { runCauseEffect } from "../../backend/effect-boundary";
+import { localSkillTools } from "../local-skill-tools";
+import { parseCreateLocalSkill, parseReadLocalSkill, parseReviseLocalSkill, parseInstallLocalSkill } from "../ipc/local-skill-inputs";
+import { parseMarketplaceSkillQuery } from "../ipc/app-inputs";
+import { requireString } from "../ipc/validation";
+import { HttpError } from "./http-error";
+import { readJson, requireAdmin, requireVisibleBodyAgent } from "./request-helpers";
+import type { TeamApiAdmin } from "./dependencies";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+export async function routeLocalCatalog(context: TeamApiRequestContext, admin: TeamApiAdmin | undefined, hidden: ReadonlySet<string>): Promise<RouteOutcome> {
+  const { method, url, capabilities, member, request, response, json } = context;
+  const bundle = method === "GET" && url.pathname === LOCAL_CATALOG_BUNDLE_PATH;
+  if (!bundle && (method !== "POST" || !Object.values(LOCAL_CATALOG_ROUTES).some(path => path === url.pathname))) return "unmatched";
+  requireAdmin(member);
+  if (!capabilities.has(LOCAL_CATALOG_CAPABILITY) || !admin?.skills?.requireLocalLibrary || !admin.marketplaceAgents?.list || !admin.marketplaceAgents.listMine) throw new HttpError(400, "Local catalog unsupported.");
+  const skills = admin.skills;
+  try {
+    if (bundle) {
+      const skillId = requireString(url.searchParams.get("skillId"), "skillId"); const revision = Number(url.searchParams.get("revision"));
+      if (!/^local-skill-[0-9a-f-]{36}$/u.test(skillId) || !Number.isSafeInteger(revision) || revision < 1) throw new HttpError(400, "Invalid local bundle identity.");
+      const bytes = await runCauseEffect(skills.requireLocalLibrary().bundle(skillId, revision));
+      response.writeHead(200, { "content-type": "application/zip", "content-length": bytes.byteLength, "cache-control": "no-store", "content-disposition": `attachment; filename="${skillId}-${revision}.zip"` }); response.end(bytes); return "handled";
+    }
+    const codec = LOCAL_CATALOG_CODECS.get(url.pathname); if (!codec) throw new HttpError(400, "Local catalog unsupported.");
+    const body = codec.request(await readJson(request)); if (!isDynamicRecord(body)) throw new HttpError(400, "Invalid catalog request.");
+    const tools = localSkillTools(skills);
+    let result: unknown;
+    switch (url.pathname) {
+      case LOCAL_CATALOG_ROUTES.searchSkills: result = await runCauseEffect(skills.list(parseMarketplaceSkillQuery(body))); break;
+      case LOCAL_CATALOG_ROUTES.skill: result = await runCauseEffect(skills.get(requireString(body.skillId, "skillId"))); break;
+      case LOCAL_CATALOG_ROUTES.skillBySlug: result = await runCauseEffect(skills.getBySlug(requireString(body.slug, "slug"))); break;
+      case LOCAL_CATALOG_ROUTES.mySkills: result = await runCauseEffect(skills.listMine()); break;
+      case LOCAL_CATALOG_ROUTES.localList: { const all = (await runCauseEffect(tools.list())).sort((a, b) => a.id.localeCompare(b.id)); const after = typeof body.after === "string" ? body.after : null; const eligible = after === null ? all : all.filter(item => item.id > after); const limit = typeof body.limit === "number" ? Math.max(1, Math.min(50, body.limit)) : 50; const page = eligible.slice(0, limit); result = { skills: page, nextCursor: eligible.length > page.length ? page.at(-1)?.id ?? null : null }; break; }
+      case LOCAL_CATALOG_ROUTES.localGet: result = await runCauseEffect(tools.get(parseReadLocalSkill(body))); break;
+      case LOCAL_CATALOG_ROUTES.localCreate: requireVisibleBodyAgent(body, hidden); result = await runCauseEffect(tools.create(parseCreateLocalSkill(body))); break;
+      case LOCAL_CATALOG_ROUTES.localRevise: requireVisibleBodyAgent(body, hidden); result = await runCauseEffect(tools.revise(parseReviseLocalSkill(body))); break;
+      case LOCAL_CATALOG_ROUTES.localInstall: requireVisibleBodyAgent(body, hidden); await runCauseEffect(tools.install(parseInstallLocalSkill(body))); result = {}; break;
+      case LOCAL_CATALOG_ROUTES.searchAgents: { const query = parseMarketplaceSkillQuery(body); result = await runCauseEffect(admin.marketplaceAgents.list({ ...query, sort: query.sort === "installs" ? "installs" : undefined })); break; }
+      case LOCAL_CATALOG_ROUTES.myAgents: result = await runCauseEffect(admin.marketplaceAgents.listMine()); break;
+      default: return "unmatched";
+    }
+    const projected = codec.response(200, result);
+    if (projected !== null && typeof projected !== "object") throw new Error("Invalid catalog result.");
+    return json(200, projected);
+  } catch (error) {
+    if (error instanceof HttpError) throw error;
+    if (isDynamicRecord(error) && error._tag === "AuthApiError" && error.status === 401 && error.code === "unauthorized") return json(409, { error: "Sign in to OpenBot on this host to browse the Marketplace.", code: "host_account_required" });
+    throw new HttpError(409, "The catalog operation could not be confirmed. Refresh the library or host account before retrying a change.");
+  }
+}
diff --git a/src/main/team-api/route-sled-bound-import.ts b/src/main/team-api/route-sled-bound-import.ts
new file mode 100644
index 0000000..ead9825
--- /dev/null
+++ b/src/main/team-api/route-sled-bound-import.ts
@@ -0,0 +1,54 @@
+import { createHash } from "node:crypto";
+import { isDynamicRecord } from "@openbot/contracts/runtime-values";
+import { SLED_IMPORT_CAPABILITY, SLED_IMPORT_CODECS } from "@openbot/contracts/team-protocol/durable-agent-import-v1";
+import type { DurableAgentImport } from "../durable-agent-import";
+import { verifyImportBinding } from "../sled-import-binding";
+import { answer } from "./route-agent-import";
+import { HttpError } from "./http-error";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readBinary, stringField } from "./request-helpers";
+
+/** Only the Sled parent holding the managed-host secret can bind an app principal. */
+export async function routeSledBoundImport(
+  context: TeamApiRequestContext,
+  binding: {service: DurableAgentImport; secret: string} | undefined,
+  hostId: string | undefined,
+  newAgentHidden: () => boolean,
+  hidden: ReadonlySet<string>,
+): Promise<RouteOutcome> {
+  const { method, url, request, capabilities, member, json } = context;
+  const codec = SLED_IMPORT_CODECS.get(url.pathname);
+  if (method !== "POST" || !codec) return "unmatched";
+  if (!binding || !hostId || !capabilities.has(SLED_IMPORT_CAPABILITY)) throw new HttpError(400, "Durable import unavailable");
+  const token = request.headers["x-sled-import-principal"];
+  if (typeof token !== "string" || token.length > 4096) throw new HttpError(403, "Import principal required");
+  const path = url.pathname + url.search;
+  let owner: string;
+  let expectedDigest: string;
+  try {
+    const claims: unknown = JSON.parse(Buffer.from(token.split(".")[0] ?? "", "base64url").toString("utf8"));
+    if (!isDynamicRecord(claims) || typeof claims.bodySha256 !== "string") throw new Error("Invalid binding");
+    expectedDigest = claims.bodySha256;
+    owner = verifyImportBinding(binding.secret, token, {hostId, method, path, bodySha256: expectedDigest}, Date.now());
+  } catch { throw new HttpError(403, "Invalid import principal"); }
+  const read = async (max: number) => {
+    const bytes = await readBinary(request, max);
+    if (createHash("sha256").update(bytes).digest("hex") !== expectedDigest) throw new HttpError(403, "Import body changed");
+    return bytes;
+  };
+  const respond = (receipt: Awaited<ReturnType<DurableAgentImport["status"]>>) => {
+    const result = receipt?.result;
+    if (isDynamicRecord(result) && Array.isArray(result.agents) && result.agents.some(agent => isDynamicRecord(agent) && typeof agent.agentId === "string" && (hidden.has(agent.agentId) || context.agentLevel(agent.agentId) === "none"))) throw new HttpError(404, "Import unavailable");
+    return json(200, receipt);
+  };
+  if (url.pathname.endsWith("/stage"))
+    return respond(await answer(() => binding.service.stageUpload(owner, url.searchParams.get("requestId") ?? "", () => read(104857600)), 400));
+  let body: ReturnType<typeof codec.request>;
+  try { body = codec.request(JSON.parse(Buffer.from(await read(65536)).toString("utf8"))); }
+  catch { throw new HttpError(400, "Invalid import body"); }
+  if (!isDynamicRecord(body)) throw new HttpError(400, "Invalid import body");
+  if (url.pathname.endsWith("/status")) return respond(await binding.service.status(owner));
+  if (url.pathname.endsWith("/discard")) return respond(await answer(() => binding.service.discard(owner, stringField(body, "token")), 409));
+  if (newAgentHidden()) throw new HttpError(400, "New agent provider is local-only");
+  return respond(await answer(() => binding.service.apply(owner, body, {id: member.id, name: member.name ?? "Team member"}), 409));
+}
diff --git a/src/main/team-api/route-sled-channel-coding.ts b/src/main/team-api/route-sled-channel-coding.ts
