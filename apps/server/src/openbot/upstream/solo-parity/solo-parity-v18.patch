@@ -0,0 +1,81 @@
+import {
+  HOST_ACCOUNT_CAPABILITY,
+  HOST_ACCOUNT_ROUTES,
+  HOST_ACCOUNT_CODECS,
+} from "@openbot/contracts/team-protocol/host-account-v1";
+import { isDynamicRecord } from "@openbot/contracts/runtime-values";
+import type { TeamApiAdmin } from "./dependencies";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readJson, requireAdmin } from "./request-helpers";
+import { HttpError } from "./http-error";
+export async function routeHostAccount(
+  context: TeamApiRequestContext,
+  admin: TeamApiAdmin | undefined,
+): Promise<RouteOutcome> {
+  const { method, url, member, request, json, capabilities } = context;
+  const codec = HOST_ACCOUNT_CODECS.get(url.pathname);
+  if (method !== "POST" || !codec) return "unmatched";
+  requireAdmin(member);
+  const account = admin?.account;
+  if (!account || !capabilities.has(HOST_ACCOUNT_CAPABILITY))
+    throw new HttpError(400, "This host does not expose account settings.");
+  let body: unknown;
+  try {
+    body = codec.request(await readJson(request));
+  } catch {
+    throw new HttpError(400, "Invalid account request.");
+  }
+  if (!isDynamicRecord(body))
+    throw new HttpError(400, "Invalid account request.");
+  const id = typeof body.flowId === "string" ? body.flowId : "";
+  let result: unknown;
+  try {
+    switch (url.pathname) {
+      case HOST_ACCOUNT_ROUTES.status:
+        result = account.status(member.id);
+        break;
+      case HOST_ACCOUNT_ROUTES.emailStart:
+        result = await account.start(member.id, String(body.email));
+        break;
+      case HOST_ACCOUNT_ROUTES.emailVerify:
+        result = await account.verify(
+          member.id,
+          id,
+          String(body.challengeId),
+          String(body.code),
+        );
+        break;
+      case HOST_ACCOUNT_ROUTES.retry:
+        result = await account.retry(member.id);
+        break;
+      case HOST_ACCOUNT_ROUTES.logout:
+        result = await account.logout(member.id);
+        break;
+      case HOST_ACCOUNT_ROUTES.companyOpen:
+        result = await account.open(member.id, id);
+        break;
+      case HOST_ACCOUNT_ROUTES.companyComplete:
+        result = await account.complete(
+          member.id,
+          id,
+          String(body.callbackQuery),
+        );
+        break;
+      case HOST_ACCOUNT_ROUTES.cancel:
+        result = await account.cancel(member.id, id);
+        break;
+      default:
+        return "unmatched";
+    }
+    const projected = codec.response(200, result);
+    if (projected === null || typeof projected !== "object")
+      throw new Error("Invalid account reply.");
+    return json(200, projected);
+  } catch (error) {
+    if (error instanceof HttpError) throw error;
+    throw new HttpError(
+      409,
+      "The host account request could not complete. Check its status before retrying.",
+    );
+  }
+}
