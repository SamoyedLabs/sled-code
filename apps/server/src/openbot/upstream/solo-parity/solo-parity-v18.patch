@@ -0,0 +1,68 @@
+import { readFile } from "node:fs/promises";
+import { isAvatarMimeType } from "@openbot/contracts/avatar-images";
+import { isDynamicRecord } from "@openbot/contracts/runtime-values";
+import { SLED_CHANNEL_PRESENTATION_CAPABILITY } from "@openbot/contracts/team-protocol/sled-channel-presentation-v1";
+import { sourceText } from "@openbot/i18n/source";
+import type { ChannelService } from "../../backend/channel-service";
+import { runCauseEffect } from "../../backend/effect-boundary";
+import { HttpError } from "./http-error";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readJson, requireAdmin, stringField } from "./request-helpers";
+
+const paths = new Set([
+  "/v1/sled/channels/presentation",
+  "/v1/sled/channels/picture",
+  "/v1/sled/channels/picture/read",
+]);
+export async function routeChannelPresentation(
+  context: TeamApiRequestContext,
+  channels: ChannelService | undefined,
+): Promise<RouteOutcome> {
+  const { method, url, capabilities, member, request, json } = context;
+  if (method !== "POST" || !paths.has(url.pathname)) return "unmatched";
+  if (!channels || !capabilities.has(SLED_CHANNEL_PRESENTATION_CAPABILITY))
+    throw new HttpError(400, sourceText("error.team.channelsUnsupported"));
+  const body = await readJson(request);
+  if (url.pathname === "/v1/sled/channels/presentation") return json(200, channels.store.presentation(member.id));
+  const channelId = stringField(body, "channelId");
+  if (!channels.store.exists(channelId)) throw new HttpError(404, sourceText("error.backend.channelNotFound"));
+  if (url.pathname.endsWith("/read")) {
+    const image = channels.images.resolve(channels.store.get(channelId));
+    if (!image || image.version !== stringField(body, "version"))
+      throw new HttpError(404, sourceText("error.team.avatarNotFound"));
+    const bytes = await readFile(image.path);
+    if (bytes.length > 524288) throw new HttpError(413, sourceText("error.team.avatarType"));
+    return json(200, { mimeType: image.mimeType, dataBase64: bytes.toString("base64") });
+  }
+  requireAdmin(member);
+  if (body.kind === "remove-image") {
+    await runCauseEffect(channels.setImage(channelId, null));
+  } else if (body.kind === "image") {
+    const mimeType = body.mimeType,
+      data = body.dataBase64;
+    if (typeof mimeType !== "string" || !isAvatarMimeType(mimeType) || typeof data !== "string")
+      throw new HttpError(415, sourceText("error.team.avatarType"));
+    const bytes = Buffer.from(data, "base64");
+    if (!bytes.length || bytes.length > 524288 || bytes.toString("base64") !== data)
+      throw new HttpError(400, sourceText("error.team.logoInvalid"));
+    await runCauseEffect(channels.setImage(channelId, { mimeType, bytes }));
+  } else {
+    let icon: { name: string; hue: number } | null = null;
+    if (body.kind === "icon") {
+      const value = body.icon;
+      if (
+        !isDynamicRecord(value) ||
+        typeof value.name !== "string" ||
+        !/^[a-z][a-z0-9-]{0,39}$/.test(value.name) ||
+        typeof value.hue !== "number" ||
+        !Number.isInteger(value.hue) ||
+        value.hue < 0 ||
+        value.hue >= 360
+      )
+        throw new HttpError(400, sourceText("error.team.logoInvalid"));
+      icon = { name: value.name, hue: value.hue };
+    }
+    await runCauseEffect(channels.setPictureIcon(channelId, icon));
+  }
+  return json(200, {});
+}
