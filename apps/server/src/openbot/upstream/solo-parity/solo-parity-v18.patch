+import { once } from "node:events";
+import { createServer } from "node:http";
+import { Effect } from "effect";
+import { expect, it } from "vitest";
+import { WebSocket } from "ws";
+import { BrowserViewGateway } from "./browser-view-gateway";
+
+it("delivers a burst of browser keys in socket order while input is asynchronous", async () => {
+  const actual: string[] = [];
+  const expected = "abcdefghijklmnopqrstuvwxyz0123456789";
+  const complete = Promise.withResolvers<void>();
+  const gateway = new BrowserViewGateway({
+    authenticate: (token) => (token === "owned" ? { id: "member" } : null),
+    browser: {
+      startView: () => Effect.succeed(() => Effect.void),
+      copyViewSelection: () => Effect.succeed(""),
+      dispatchViewInput: (_tab, input) =>
+        Effect.gen(function* () {
+          if (input.type !== "key" || input.action !== "char") return;
+          actual.push(input.text ?? "");
+          if (actual.length === expected.length) complete.resolve();
+          yield* Effect.promise(() => new Promise<void>((resolve) => setImmediate(resolve)));
+        }),
+    },
+  });
+  const server = createServer();
+  server.on("upgrade", (request, socket, head) =>
+    gateway.handleUpgrade(request, socket, head, new URL(request.url ?? "/", "http://owned.invalid")),
+  );
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const address = server.address();
+  if (!address || typeof address === "string") throw Error("Missing fixture address");
+  const grant = gateway.createSession({ memberId: "member", teamSessionId: "team", tabId: "tab" });
+  const peer = new WebSocket(`ws://127.0.0.1:${address.port}${grant.streamPath}`, ["openbot-token.owned"]);
+  try {
+    await once(peer, "open");
+    for (const key of expected) {
+      peer.send(
+        JSON.stringify({ type: "key", action: "char", key, code: `Key${key.toUpperCase()}`, text: key, modifiers: 0 }),
+      );
+      await new Promise<void>((resolve) => setImmediate(resolve));
+    }
+    await complete.promise;
+    expect(actual.join("")).toBe(expected);
+  } finally {
+    peer.terminate();
+    await Effect.runPromise(gateway.stop());
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+});
