@@ -0,0 +1,34 @@
+import type { AgentService } from "../../backend/agent-service";
+import type { PrivilegedOwnership } from "../../backend/database/privileged-ownership";
+import type { PrivilegedCommitClient } from "./privileged-commit-client";
+import { createPrivilegedResponseAuthority } from "./privileged-response-authority";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { type PrivilegedResponseAuthority, routeSledPrivilegedResponses } from "./route-sled-privileged-responses";
+
+export interface PrivilegedResponseHost {
+  readonly agents: AgentService;
+  readonly enabled: boolean;
+  readonly secret: string;
+  readonly environmentId: string;
+  readonly client: PrivilegedCommitClient;
+  readonly ownership: PrivilegedOwnership;
+}
+export async function routeBoundPrivilegedResponses(
+  context: TeamApiRequestContext,
+  host: PrivilegedResponseHost | undefined,
+  binding: {
+    hostId: string | undefined;
+    authorizeMember(target: Parameters<PrivilegedResponseAuthority["assertUpstream"]>[1]): void;
+  },
+): Promise<RouteOutcome> {
+  if (!host?.enabled || !binding.hostId) return "unmatched";
+  return routeSledPrivilegedResponses(
+    context,
+    host.agents,
+    createPrivilegedResponseAuthority({
+      ...host,
+      hostId: binding.hostId,
+      authorizeMember: binding.authorizeMember,
+    }),
+  );
+}
