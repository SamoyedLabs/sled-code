+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import type { AgentSummary } from "@openbot/contracts/ipc";
+import { expect, test } from "vitest";
+import { runCauseEffect } from "./effect-boundary";
+import { OpenBotDatabase } from "./openbot-database";
+
+test("actual roster replace and ensure-thread preserve acquired upstream ownership", async () => {
+  const root = mkdtempSync(join(tmpdir(), "ownership-v2-"));
+  const db = new OpenBotDatabase(root);
+  try {
+    await runCauseEffect(db.initialize());
+    const agent: AgentSummary = {
+      id: "agent",
+      threadId: "thread",
+      name: "Private fixture",
+      model: "gpt-5",
+      title: "",
+      description: "",
+      notifications: false,
+      provider: "codex",
+      reasoningEffort: "medium",
+      workspacePath: root,
+      preview: "",
+      avatarSeed: "private",
+      avatarHue: null,
+      avatarUrl: null,
+      updatedAt: "2026-01-01",
+    };
+    db.replaceAgents("seed", [agent], "agents.updated");
+    const lease = db.privilegedOwnership.acquire(
+      { agentId: "agent", threadId: "thread" },
+      "nonce",
+      "private-incarnation",
+    );
+    db.replaceAgents("metadata", [{ ...agent, name: "Metadata change" }], "agents.updated");
+    expect(() => db.replaceAgents("move", [{ ...agent, threadId: "other" }], "agents.updated")).toThrow();
+    expect(() => db.replaceAgents("delete", [], "agents.updated")).toThrow();
+    expect(() => db.privilegedOwnership.assertReassignment("agent", "other")).toThrow();
+    db.privilegedOwnership.assertTarget({
+      agentId: "agent",
+      threadId: "thread",
+    });
+    const other = new DatabaseSync(db.path);
+    try {
+      expect(() => other.exec("UPDATE projection_threads SET agent_id='another' WHERE thread_id='thread'")).toThrow();
+    } finally {
+      other.close();
+    }
+    lease.release();
+    db.replaceAgents("move-after-ack", [{ ...agent, threadId: "other" }], "agents.updated");
+    expect(() =>
+      db.privilegedOwnership.acquire({ agentId: "agent", threadId: "thread" }, "next", "private-incarnation"),
+    ).toThrow();
+  } finally {
+    db.close();
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("actual AgentStore restore and ensure-thread cannot replace an acquired original", async () => {
+  const { AgentStore } = await import("./agent-store");
+  const root = mkdtempSync(join(tmpdir(), "agent-ownership-v2-"));
+  const db = new OpenBotDatabase(root);
+  const store = new AgentStore(root, root, db);
+  try {
+    await runCauseEffect(store.initialize());
+    await runCauseEffect(store.getOrCreate("agent-private"));
+    const thread = await runCauseEffect(store.ensureThreadId("agent-private"));
+    const permit = db.privilegedOwnership.acquire(
+      { agentId: "agent-private", threadId: thread },
+      "store-attempt",
+      "engine",
+    );
+    expect(() => store.restoreThreadIdentity("agent-private", null, null)).toThrow();
+    expect(() => store.restoreThreadIdentity("agent-private", "replacement", null)).toThrow();
+    expect(store.ownsThread(thread)).toBe(true);
+    expect(store.ensureThreadIdNow("agent-private")).toBe(thread);
+    permit.release();
+    store.restoreThreadIdentity("agent-private", null, null);
+    expect(await runCauseEffect(store.ensureThreadId("agent-private"))).toBe(thread);
+  } finally {
+    db.close();
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+test("group prompts keep their current membership through the private commit", async () => {
+  const { AgentStore } = await import("./agent-store");
+  const { ChannelStore } = await import("./channel-store");
+  const root = mkdtempSync(join(tmpdir(), "channel-ownership-"));
+  const db = new OpenBotDatabase(root);
+  const store = new AgentStore(root, root, db);
+  try {
+    await runCauseEffect(store.initialize());
+    await runCauseEffect(store.getOrCreate("agent-group"));
+    const channels = new ChannelStore(db);
+    const channel = channels.create("private-group", {
+      name: "Private group",
+      title: "",
+      instructions: "",
+      members: [{ agentId: "agent-group" }],
+      leadAgentId: "agent-group",
+    });
+    channels.commit("create", { channel, messages: [], tasks: [], assignments: [] });
+    const { threadId } = channels.context(channel.id, "agent-group");
+    const target = { agentId: "agent-group", threadId };
+    expect(() => db.privilegedOwnership.assertTarget(target)).not.toThrow();
+    expect(() => db.privilegedOwnership.assertTarget({ ...target, agentId: "foreign" })).toThrow();
+    const permit = db.privilegedOwnership.acquire(target, "group-attempt", "engine");
+    const other = new DatabaseSync(db.path);
+    try {
+      for (const sql of [
+        "DELETE FROM projection_channel_contexts",
+        "UPDATE projection_channel_contexts SET thread_id='replacement'",
