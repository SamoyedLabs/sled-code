+import { localSkillTools } from "../local-skill-tools";
+import { parseCreateLocalSkill, parseReadLocalSkill, parseReviseLocalSkill, parseInstallLocalSkill } from "../ipc/local-skill-inputs";
+import { parseMarketplaceSkillQuery } from "../ipc/app-inputs";
+import { requireString } from "../ipc/validation";
+import { HttpError } from "./http-error";
+import { readJson, requireAdmin, requireVisibleBodyAgent } from "./request-helpers";
+import type { TeamApiAdmin } from "./dependencies";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+export async function routeLocalCatalog(context: TeamApiRequestContext, admin: TeamApiAdmin | undefined, hidden: ReadonlySet<string>): Promise<RouteOutcome> {
+  const { method, url, capabilities, member, request, response, json } = context;
+  const bundle = method === "GET" && url.pathname === LOCAL_CATALOG_BUNDLE_PATH;
+  if (!bundle && (method !== "POST" || !Object.values(LOCAL_CATALOG_ROUTES).some(path => path === url.pathname))) return "unmatched";
+  requireAdmin(member);
+  if (!capabilities.has(LOCAL_CATALOG_CAPABILITY) || !admin?.skills?.requireLocalLibrary || !admin.marketplaceAgents?.list || !admin.marketplaceAgents.listMine) throw new HttpError(400, "Local catalog unsupported.");
+  const skills = admin.skills;
