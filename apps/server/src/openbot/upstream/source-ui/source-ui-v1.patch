+import { describe, expect, it } from "vitest";
+import { LOCAL_CATALOG_CODECS, LOCAL_CATALOG_ROUTES } from "./local-skill-catalog-v1";
+
+describe("local catalog closed wire", () => {
+  const skill = { id: "skill", slug: "skill", name: "Review", description: "Review code", category: "coding", creatorName: "Author", version: 2, installs: 3, featured: true, updatedAt: "2026-11-09", verified: true, iconUrl: "https://openbot.run/skill.png", creatorAvatarUrl: null };
+  it("keeps upstream trust and artwork metadata while dropping unrelated producer fields", () => {
+    const codec = LOCAL_CATALOG_CODECS.get(LOCAL_CATALOG_ROUTES.searchSkills)!;
+    expect(codec.response(200, { skills: [{ ...skill, credential: "not part of the wire" }], nextCursor: null })).toEqual({ skills: [skill], nextCursor: null });
+    expect(() => codec.response(200, { skills: [{ ...skill, iconUrl: "https://openbot.run/" + "x".repeat(2048) }], nextCursor: null })).toThrow();
+  });
+  it("pins local installation identity and revision, bounds searches and rejects malformed replies", () => {
+    const install = LOCAL_CATALOG_CODECS.get(LOCAL_CATALOG_ROUTES.localInstall)!;
+    expect(install.request({ agentId: "agent", skillId: "skill", revision: 2 })).toEqual({ agentId: "agent", skillId: "skill", revision: 2 });
+    expect(() => install.request({ agentId: "agent", skillId: "skill", revision: -1 })).toThrow();
+    expect(() => LOCAL_CATALOG_CODECS.get(LOCAL_CATALOG_ROUTES.searchSkills)!.request({ query: "x".repeat(257) })).toThrow();
+    expect(() => LOCAL_CATALOG_CODECS.get(LOCAL_CATALOG_ROUTES.searchSkills)!.response(200, { skills: [{ ...skill, version: "2" }], nextCursor: null })).toThrow();
+  });
+});
