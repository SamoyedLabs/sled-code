+  requestHash: hash,
+  deliveryId: identifier,
+  editId: identifier,
+  expectedRevision: hash,
+  messageId: identifier,
+  attachments: list(attachment, 10),
+});
+export const SLED_QUEUE_ATTACHMENTS_CAPABILITY = "sled-queue-attachments-v1";
+export const SLED_QUEUE_ATTACHMENTS_CODECS: ReadonlyMap<string, OptionalRouteCodec> = new Map<
+  string,
+  OptionalRouteCodec
+>([
+  [
+    "/v1/sled/queue-attachments/context",
+    adminRoute(
+      decodeQueueAttachmentContext,
+      fields({ expectedRevision: hash, text: string(100000), keepAttachmentIds: list(identifier, 10) }),
+    ),
+  ],
+  ...["save", "result"].map(
+    (action) =>
+      [`/v1/sled/queue-attachments/${action}`, adminRoute(decodeQueueAttachmentEdit, nullable(receipt))] as const,
+  ),
+]);
