+import type { PrivilegedOwnership } from "../../backend/database/privileged-ownership";
+import type { PrivilegedCommitClient } from "./privileged-commit-client";
+import type { PrivilegedResponseAuthority } from "./route-sled-privileged-responses";
+
+type Target = Parameters<PrivilegedResponseAuthority["assertUpstream"]>[1];
+const key = (principal: string, target: Target) =>
+  JSON.stringify([
+    principal,
+    target.agentId,
+    target.threadId,
+    target.turnId,
+    target.messageId,
+    target.blockId,
+    target.requestId,
+  ]);
+
+/** Joins the verified route principal to the upstream database and inherited commit channel. */
+export function createPrivilegedResponseAuthority(options: {
+  secret: string;
+  environmentId: string;
+  hostId: string;
+  ownership: PrivilegedOwnership;
+  client: PrivilegedCommitClient;
+  authorizeMember(target: Target): void;
+}): PrivilegedResponseAuthority {
+  const active = new Map<string, string>();
+  const assertUpstream = (principal: string, target: Target) => {
+    options.authorizeMember(target);
+    options.ownership.assertTarget(target);
+    const nonce = active.get(key(principal, target));
+    if (nonce !== undefined) options.client.assertDeadline(nonce);
+  };
+  return {
+    secret: options.secret,
+    environmentId: options.environmentId,
+    hostId: options.hostId,
+    assertUpstream,
+    async acquireCommit(principal, target, nonce) {
+      assertUpstream(principal, target);
+      const identity = key(principal, target);
+      if (active.has(identity)) throw new Error("Privileged response unavailable");
+      const incarnation = await options.client.ready();
+      assertUpstream(principal, target);
+      const ownership = options.ownership.acquire(target, nonce, incarnation);
+      active.set(identity, nonce);
+      try {
+        const permit = await options.client.acquireCommit(principal, target, nonce);
+        return {
+          release: async () => {
+            await permit.release();
+            ownership.release();
+            active.delete(identity);
+          },
+        };
+      } catch (error) {
+        // A lost acquisition reply cannot be retried. Keep the mapping obligation until
+        // the retained supervisor observes this engine exit and reconciles its database.
+        options.client.close();
+        throw error;
+      }
+    },
+  };
+}
