+    return this.#ready;
+  }
+  assertDeadline(nonce: string): void {
+    const deadline = this.#leases.get(nonce);
+    if (this.#closed || this.#membershipChanges || (deadline !== undefined && Date.now() >= deadline))
+      throw unavailable();
+  }
+  async acquireCommit(principal: string, target: Target, nonce: string) {
+    await this.ready();
+    if (this.#attempts.has(nonce)) throw unavailable();
+    this.#attempts.add(nonce);
+    const active = this.#beginAttempt();
+    const input = { principal, target: { ...target }, nonce };
+    const reply = await this.#request("acquire", input).catch((error) => {
+      this.close();
+      throw error;
+    });
+    if (typeof reply.permit !== "string" || typeof reply.deadline !== "number" || !Number.isFinite(reply.deadline)) {
+      this.close();
+      throw unavailable();
+    }
+    this.#leases.set(nonce, reply.deadline);
+    let released = false;
+    return {
+      release: async () => {
+        if (released) throw unavailable();
+        released = true;
+        await this.#request("finish", input, reply.permit);
+        this.#leases.delete(nonce);
+        this.#finishAttempt(active);
+      },
+    };
+  }
