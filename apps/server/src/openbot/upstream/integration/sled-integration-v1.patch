+import type { DatabaseSync } from "node:sqlite";
+
+type Target = { agentId: string; threadId: string };
+export const PRIVILEGED_OWNERSHIP_SQL = `
+CREATE TABLE privileged_response_ownership (
+ nonce TEXT PRIMARY KEY, incarnation TEXT NOT NULL, agent_id TEXT NOT NULL, thread_id TEXT NOT NULL,
+ state TEXT NOT NULL CHECK(state IN ('outstanding','finished','exited'))
+);
+CREATE TRIGGER privileged_agent_delete BEFORE DELETE ON projection_agents
+ WHEN EXISTS(SELECT 1 FROM privileged_response_ownership WHERE state='outstanding' AND agent_id=OLD.agent_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_agent_update BEFORE UPDATE OF agent_id,thread_id ON projection_agents
+ WHEN (NEW.agent_id IS NOT OLD.agent_id OR NEW.thread_id IS NOT OLD.thread_id)
+ AND EXISTS(SELECT 1 FROM privileged_response_ownership WHERE state='outstanding' AND agent_id=OLD.agent_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_thread_delete BEFORE DELETE ON projection_threads
+ WHEN EXISTS(SELECT 1 FROM privileged_response_ownership WHERE state='outstanding' AND thread_id=OLD.thread_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_thread_update BEFORE UPDATE OF agent_id,thread_id ON projection_threads
+ WHEN (NEW.agent_id IS NOT OLD.agent_id OR NEW.thread_id IS NOT OLD.thread_id)
+ AND EXISTS(SELECT 1 FROM privileged_response_ownership WHERE state='outstanding' AND thread_id=OLD.thread_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_additional_delete BEFORE DELETE ON projection_agent_threads
+ WHEN EXISTS(SELECT 1 FROM privileged_response_ownership WHERE state='outstanding' AND thread_id=OLD.thread_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_additional_update BEFORE UPDATE OF agent_id,thread_id ON projection_agent_threads
+ WHEN (NEW.agent_id IS NOT OLD.agent_id OR NEW.thread_id IS NOT OLD.thread_id)
+ AND EXISTS(SELECT 1 FROM privileged_response_ownership WHERE state='outstanding' AND thread_id=OLD.thread_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_projection_agents_replace BEFORE INSERT ON projection_agents
+ WHEN EXISTS(SELECT 1 FROM projection_agents old JOIN privileged_response_ownership p
+ ON p.agent_id=old.agent_id WHERE p.state='outstanding' AND old.agent_id=NEW.agent_id
+ AND old.thread_id IS NOT NEW.thread_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_projection_threads_replace BEFORE INSERT ON projection_threads
+ WHEN EXISTS(SELECT 1 FROM projection_threads old JOIN privileged_response_ownership p
+ ON p.thread_id=old.thread_id WHERE p.state='outstanding' AND old.thread_id=NEW.thread_id
+ AND old.agent_id IS NOT NEW.agent_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+CREATE TRIGGER privileged_projection_agent_threads_replace BEFORE INSERT ON projection_agent_threads
+ WHEN EXISTS(SELECT 1 FROM projection_agent_threads old JOIN privileged_response_ownership p
+ ON p.thread_id=old.thread_id WHERE p.state='outstanding' AND old.thread_id=NEW.thread_id
+ AND old.agent_id IS NOT NEW.agent_id)
+ BEGIN SELECT RAISE(ABORT,'Privileged ownership drain required'); END;
+`;
+
+/** Owns the upstream mapping barrier; Sled coding projections cannot authorize it. */
+export class PrivilegedOwnership {
+  readonly connection: () => DatabaseSync;
+  constructor(connection: () => DatabaseSync) {
+    this.connection = connection;
+  }
+  assertTarget(target: Target): void {
+    const row = this.connection()
+      .prepare(
+        `SELECT 1 FROM projection_threads t
+      JOIN projection_agents a ON a.agent_id=t.agent_id
+      WHERE t.thread_id=? AND t.agent_id=? AND
+       (a.thread_id=t.thread_id OR EXISTS(SELECT 1 FROM projection_agent_threads x
+         WHERE x.thread_id=t.thread_id AND x.agent_id=t.agent_id))`,
+      )
+      .get(target.threadId, target.agentId);
+    if (!row) throw new Error("Privileged response unavailable");
+  }
+  assertReassignment(agentId: string, threadId: string | null): void {
+    const row = this.connection()
+      .prepare(
+        `SELECT 1 FROM privileged_response_ownership
+      WHERE state='outstanding' AND agent_id=? AND thread_id IS NOT ?`,
+      )
+      .get(agentId, threadId);
+    if (row) throw new Error("Privileged ownership drain required");
+  }
+  acquire(target: Target, nonce: string, incarnation: string): { release(): void } {
+    const db = this.connection();
+    db.exec("SAVEPOINT privileged_ownership_acquire");
+    try {
+      // Write before reading: exclude a concurrent owner change on another connection.
+      db.prepare("INSERT INTO privileged_response_ownership VALUES (?,?,?,?,'outstanding')").run(
+        nonce,
+        incarnation,
+        target.agentId,
+        target.threadId,
+      );
+      this.assertTarget(target);
+      db.exec("RELEASE privileged_ownership_acquire");
+    } catch (error) {
+      db.exec("ROLLBACK TO privileged_ownership_acquire; RELEASE privileged_ownership_acquire");
+      throw error;
+    }
+    let released = false;
+    return {
+      release: () => {
+        if (released) throw new Error("Privileged response unavailable");
+        db.prepare(
+          "UPDATE privileged_response_ownership SET state='finished' WHERE nonce=? AND state='outstanding'",
+        ).run(nonce);
+        released = true;
+      },
+    };
+  }
+}
