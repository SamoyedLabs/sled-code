+import { describe, expect, test } from "vitest";
+import { PRIVILEGED_RESPONSE_CODECS } from "./privileged-response-codecs";
+import { teamSideRouteCodec } from "./side-routes";
+
+describe("privileged status envelopes", () => {
+  for (const action of ["context", "respond", "result"]) {
+    const path = `/v1/sled/privileged-responses/${action}`;
+    test.each([400, 401, 403, 404, 409, 500])(`${action} returns HTTP %i as an error envelope`, (status) => {
+      const input = {
+        error: "Privileged response unavailable",
+        code: "REFUSED",
+        secret: "must-not-escape",
+        nonce: "not-success",
+      };
+      expect(PRIVILEGED_RESPONSE_CODECS.get(path)?.response(status, input)).toEqual({
+        error: input.error,
+        code: "REFUSED",
+      });
+      const encoded = JSON.stringify(teamSideRouteCodec(path)?.response(path, status, input, {}));
+      expect(JSON.parse(encoded)).toEqual({ error: input.error, code: "REFUSED" });
+      expect(encoded).not.toContain("must-not-escape");
+      expect(encoded).not.toContain("nonce");
+    });
+    test(`${action} still validates successful result`, () => {
+      expect(
+        PRIVILEGED_RESPONSE_CODECS.get(path)?.response(200, { nonce: "original", status: "answered", secret: "drop" }),
+      ).toEqual({ nonce: "original", status: "answered" });
+      expect(() => PRIVILEGED_RESPONSE_CODECS.get(path)?.response(200, { error: "not-success" })).toThrow(
+        "Invalid secure response",
+      );
+    });
+  }
+});
