+import { Schema } from "effect";
+import { adminRoute, type OptionalRouteCodec } from "./admin-wire";
+import { PrivilegedResponseRequest, PrivilegedResponseResult } from "./sled-privileged-responses-v1";
+
+const unavailable = (): never => {
+  throw new Error("Invalid secure response");
+};
+export const PRIVILEGED_RESPONSE_CODECS: ReadonlyMap<string, OptionalRouteCodec> = new Map<string, OptionalRouteCodec>(
+  ["context", "respond", "result"].map(
+    (action) =>
+      [
+        `/v1/sled/privileged-responses/${action}`,
+        adminRoute(
+          (value: unknown) => {
+            const result = Schema.decodeUnknownOption(PrivilegedResponseRequest)(value, { onExcessProperty: "error" });
+            if (result._tag !== "Some") return unavailable();
+            const input = result.value;
+            if (input.operation === "privilegedResponse.respond")
+              return {
+                ...input,
+                response: {
+                  actionId: input.response.actionId,
+                  values: Object.fromEntries(
+                    Object.entries(input.response.values ?? {}).map(([key, v]) => [
+                      key,
+                      typeof v === "string" ? v : [...v],
+                    ]),
+                  ),
+                },
+              };
+            return { ...input };
+          },
+          (value: unknown) => {
+            const result = Schema.decodeUnknownOption(PrivilegedResponseResult)(value);
+            return result._tag === "Some" ? { nonce: result.value.nonce, status: result.value.status } : unavailable();
+          },
+        ),
+      ] as const,
+  ),
+);
