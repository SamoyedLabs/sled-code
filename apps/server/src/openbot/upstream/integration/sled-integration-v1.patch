+import { createHash } from "node:crypto";
+import { isDynamicRecord } from "@openbot/contracts/runtime-values";
+import { SLED_IMPORT_CAPABILITY, SLED_IMPORT_CODECS } from "@openbot/contracts/team-protocol/durable-agent-import-v1";
+import type { DurableAgentImport } from "../durable-agent-import";
+import { verifyImportBinding } from "../sled-import-binding";
+import { answer } from "./route-agent-import";
+import { HttpError } from "./http-error";
+import type { RouteOutcome, TeamApiRequestContext } from "./request-context";
+import { readBinary, stringField } from "./request-helpers";
+
+/** Only the Sled parent holding the managed-host secret can bind an app principal. */
+export async function routeSledBoundImport(
+  context: TeamApiRequestContext,
+  binding: {service: DurableAgentImport; secret: string} | undefined,
+  hostId: string | undefined,
+  newAgentHidden: () => boolean,
+  hidden: ReadonlySet<string>,
+): Promise<RouteOutcome> {
+  const { method, url, request, capabilities, member, json } = context;
+  const codec = SLED_IMPORT_CODECS.get(url.pathname);
+  if (method !== "POST" || !codec) return "unmatched";
+  if (!binding || !hostId || !capabilities.has(SLED_IMPORT_CAPABILITY)) throw new HttpError(400, "Durable import unavailable");
+  const token = request.headers["x-sled-import-principal"];
+  if (typeof token !== "string" || token.length > 4096) throw new HttpError(403, "Import principal required");
+  const path = url.pathname + url.search;
+  let owner: string;
+  let expectedDigest: string;
+  try {
+    const claims: unknown = JSON.parse(Buffer.from(token.split(".")[0] ?? "", "base64url").toString("utf8"));
+    if (!isDynamicRecord(claims) || typeof claims.bodySha256 !== "string") throw new Error("Invalid binding");
+    expectedDigest = claims.bodySha256;
+    owner = verifyImportBinding(binding.secret, token, {hostId, method, path, bodySha256: expectedDigest}, Date.now());
+  } catch { throw new HttpError(403, "Invalid import principal"); }
+  const read = async (max: number) => {
+    const bytes = await readBinary(request, max);
+    if (createHash("sha256").update(bytes).digest("hex") !== expectedDigest) throw new HttpError(403, "Import body changed");
+    return bytes;
+  };
+  const respond = (receipt: Awaited<ReturnType<DurableAgentImport["status"]>>) => {
+    const result = receipt?.result;
+    if (isDynamicRecord(result) && Array.isArray(result.agents) && result.agents.some(agent => isDynamicRecord(agent) && typeof agent.agentId === "string" && (hidden.has(agent.agentId) || context.agentLevel(agent.agentId) === "none"))) throw new HttpError(404, "Import unavailable");
+    return json(200, receipt);
+  };
+  if (url.pathname.endsWith("/stage"))
+    return respond(await answer(() => binding.service.stageUpload(owner, url.searchParams.get("requestId") ?? "", () => read(104857600)), 400));
+  let body: ReturnType<typeof codec.request>;
+  try { body = codec.request(JSON.parse(Buffer.from(await read(65536)).toString("utf8"))); }
+  catch { throw new HttpError(400, "Invalid import body"); }
+  if (!isDynamicRecord(body)) throw new HttpError(400, "Invalid import body");
+  if (url.pathname.endsWith("/status")) return respond(await binding.service.status(owner));
+  if (url.pathname.endsWith("/discard")) return respond(await answer(() => binding.service.discard(owner, stringField(body, "token")), 409));
+  if (newAgentHidden()) throw new HttpError(400, "New agent provider is local-only");
+  return respond(await answer(() => binding.service.apply(owner, body, {id: member.id, name: member.name ?? "Team member"}), 409));
+}
