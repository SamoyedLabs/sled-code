+import { decodeCodingProgress } from "../../backend/channel-coding-extension";
+import { parseChannelCommand } from "@openbot/contracts/ipc";
+import { SLED_CHANNEL_CODING_CAPABILITY, SLED_CHANNEL_CODING_ROUTES, SLED_CHANNEL_CODING_CODECS } from "@openbot/contracts/team-protocol/sled-channel-coding-v1";
+import { sourceText } from "@openbot/i18n/source";
+import type { ChannelCodingRuntime } from "../../backend/channel-coding-runtime";
+import { runCauseEffect } from "../../backend/effect-boundary";
+import { HttpError } from "./http-error";
+import type { TeamApiRequestContext, RouteOutcome } from "./request-context";
+import { readJson, requireAdmin, stringField } from "./request-helpers";
+export async function routeSledChannelCoding(context:TeamApiRequestContext,runtime:ChannelCodingRuntime|undefined):Promise<RouteOutcome> {
+ const {method,url,capabilities,member,request,json}=context;
+ const codec=SLED_CHANNEL_CODING_CODECS.get(url.pathname);
+ if(method!=="POST" || !codec)return "unmatched";
+ requireAdmin(member);
+ if(!runtime||!capabilities.has(SLED_CHANNEL_CODING_CAPABILITY))throw new HttpError(400,sourceText("error.team.channelsUnsupported"));
+ const body=await readJson(request);
+ const result=await (async()=>{
+ switch(url.pathname){
+ case SLED_CHANNEL_CODING_ROUTES.progress:return runCauseEffect(runtime.progress(stringField(body,"credential"),decodeCodingProgress(body.event)));
+ case SLED_CHANNEL_CODING_ROUTES.status:return runtime.status();
+ case SLED_CHANNEL_CODING_ROUTES.configure:return runtime.configure(stringField(body,"mcpServerId"));
+ case SLED_CHANNEL_CODING_ROUTES.send:{
+ const command=parseChannelCommand(body.command);
+ if(command.type!=="send")throw new HttpError(400,"Expected a channel send.");
+ return runCauseEffect(runtime.send(command,{id:member.id,name:member.name??"Team member"},stringField(body,"originRef")));
+ }
+ case SLED_CHANNEL_CODING_ROUTES.recover:return runtime.recover(stringField(body,"originRef"),stringField(body,"channelId"),stringField(body,"operationId"),member.id);
+ case SLED_CHANNEL_CODING_ROUTES.verify:{const purpose=stringField(body,"purpose");if(purpose!=="launch"&&purpose!=="reconcile")throw new HttpError(400,"Invalid credential purpose.");return runtime.verify(stringField(body,"credential"),purpose);}
+ case SLED_CHANNEL_CODING_ROUTES.renew:return runCauseEffect(runtime.renew(stringField(body,"credential")));
+ case SLED_CHANNEL_CODING_ROUTES.receipt:return runCauseEffect(runtime.receipt(stringField(body,"credential")));
+ case SLED_CHANNEL_CODING_ROUTES.submit:return runCauseEffect(runtime.submit(stringField(body,"credential"),stringField(body,"text")));
+ default:throw new HttpError(400,"Invalid channel operation.");
+ }
+ })();
+ const response=codec.response(200,result);
+ if(response!==null&&(typeof response!=="object"||Array.isArray(response)))throw new Error("Invalid channel response.");
+ return json(200,response);
+}
